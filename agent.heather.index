<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Agent Heather — Weekly Feedback</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
    background: #f5f5f7;
    color: #1d1d1f;
    min-height: 100vh;
  }
  .wrap { max-width: 620px; margin: 0 auto; padding: 2.5rem 1.25rem 5rem; }
  .header { margin-bottom: 2rem; }
  .header h1 { font-size: 28px; font-weight: 600; letter-spacing: -0.5px; color: #1d1d1f; }
  .header p { font-size: 14px; color: #6e6e73; margin-top: 5px; }
  .dish-card {
    background: #fff;
    border: 0.5px solid #d2d2d7;
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }
  .dish-name { font-size: 15px; font-weight: 500; color: #1d1d1f; margin-bottom: 1rem; }
  .rater-section { margin-bottom: 12px; }
  .rater-pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 8px;
  }
  .score-btns { display: flex; gap: 3px; flex-wrap: wrap; }
  .score-btn {
    width: 32px;
    height: 28px;
    border-radius: 6px;
    border: none;
    font-size: 11px;
    font-weight: 400;
    cursor: pointer;
    transition: transform 0.08s, opacity 0.08s;
    opacity: 0.45;
  }
  .score-btn:hover { opacity: 0.75; }
  .score-btn.selected { opacity: 1; font-weight: 600; box-shadow: 0 0 0 2px rgba(0,0,0,0.15); }
  .score-btn:active { transform: scale(0.93); }
  .dish-total {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 0.5px solid #d2d2d7;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .dish-total-label { font-size: 12px; color: #aeaeb2; }
  .dish-total-val { font-size: 15px; font-weight: 500; color: #1d1d1f; }
  .divider { height: 0.5px; background: #d2d2d7; margin: 1.5rem 0; }
  .overall-card {
    background: #fff;
    border: 0.5px solid #d2d2d7;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .overall-label { font-size: 14px; color: #6e6e73; }
  .overall-sub { font-size: 12px; color: #aeaeb2; margin-top: 2px; }
  .overall-num { font-size: 36px; font-weight: 600; letter-spacing: -1.5px; color: #1d1d1f; }
  .overall-denom { font-size: 16px; font-weight: 400; color: #6e6e73; }
  .submit-btn {
    width: 100%;
    padding: 14px;
    border-radius: 10px;
    border: none;
    background: #1d1d1f;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.15s;
  }
  .submit-btn:hover { opacity: 0.82; }
  .loading { text-align: center; padding: 3rem 0; color: #6e6e73; font-size: 15px; }
  .success-banner {
    background: #f0faf4;
    border: 0.5px solid #a8d5b5;
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
    color: #1d6b3e;
    font-size: 15px;
    font-weight: 500;
    display: none;
    margin-bottom: 1rem;
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <h1>This week's menu</h1>
    <p id="week-date"></p>
  </div>
  <div id="loading" class="loading">Loading this week's menu...</div>
  <div id="dishes-container"></div>
  <div id="form-footer" style="display:none">
    <div class="divider"></div>
    <div class="overall-card">
      <div>
        <div class="overall-label">Overall score</div>
        <div class="overall-sub">All dishes, all ratings</div>
      </div>
      <div>
        <span class="overall-num" id="overall-num">—</span>
        <span class="overall-denom" id="overall-denom"></span>
      </div>
    </div>
    <div class="success-banner" id="success-banner">Feedback submitted! Thanks for rating this week's menu.</div>
    <button class="submit-btn" onclick="handleSubmit()">Submit feedback</button>
  </div>
</div>

<script>
const SHEET_ID = '12me4KLiQer_cJhkyCZIdRu7QmMyatfHhMefxNNjWUW4';
const API_KEY = 'AIzaSyAmF74sjtDZrsw2ltQW8m2_CkFAX0pPgAY';
const SHEET_RANGE = 'Sheet1!A:D';

const raters = [
  {
    name: 'Alex',
    pill: { bg: '#E6F1FB', text: '#0C447C', border: '#85B7EB' },
    scale: ['#E6F1FB','#C5DDF7','#9DC4F1','#75ABEA','#4D92E3','#3580CF','#1D6DBB','#0F5AA0','#084785','#042C53']
  },
  {
    name: 'Noreen',
    pill: { bg: '#EAF3DE', text: '#27500A', border: '#97C459' },
    scale: ['#EAF3DE','#CDE3B0','#AECF7C','#8FBB52','#70A632','#538C1E','#3B6D11','#27500A','#173404','#0D2002']
  },
  {
    name: 'Elia',
    pill: { bg: '#FBEAF0', text: '#72243E', border: '#ED93B1' },
    scale: ['#FBEAF0','#F4C8D8','#EDA4BE','#E67FA4','#D4537E','#BB3A65','#993556','#72243E','#4B1528','#2E0B18']
  }
];

let dishes = [];
const scores = {};

function getNextMonday() {
  const d = new Date();
  const day = d.getDay();
  const diff = (8 - day) % 7 || 7;
  d.setDate(d.getDate() + diff);
  return d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
}

document.getElementById('week-date').textContent = getNextMonday();

async function loadDishes() {
  try {
    const url = `https://sheets.googleapis.com/v4/spreadsheets/${SHEET_ID}/values/${SHEET_RANGE}?key=${API_KEY}`;
    const res = await fetch(url);
    const data = await res.json();
    const rows = data.values || [];

    const seen = new Set();
    dishes = [];
    rows.forEach(row => {
      const name = row[1];
      if (name && name !== 'Dish Name' && !seen.has(name)) {
        seen.add(name);
        dishes.push(name);
        scores[name] = { Alex: null, Noreen: null, Elia: null };
      }
    });

    document.getElementById('loading').style.display = 'none';
    document.getElementById('form-footer').style.display = 'block';
    render();
  } catch (e) {
    document.getElementById('loading').textContent = 'Could not load menu. Please try again later.';
  }
}

function render() {
  const container = document.getElementById('dishes-container');
  container.innerHTML = '';

  dishes.forEach(dish => {
    const card = document.createElement('div');
    card.className = 'dish-card';

    const vals = Object.values(scores[dish]).filter(v => v !== null);
    const total = vals.reduce((s, v) => s + v, 0);
    const totalStr = vals.length > 0 ? `${total} / ${vals.length * 10}` : '—';

    card.innerHTML = `
      <div class="dish-name">${dish}</div>
      ${raters.map(r => `
        <div class="rater-section">
          <div class="rater-pill" style="background:${r.pill.bg}; color:${r.pill.text}; border: 0.5px solid ${r.pill.border}">${r.name}</div>
          <div class="score-btns">
            ${r.scale.map((bg, i) => {
              const n = i + 1;
              const sel = scores[dish][r.name] === n;
              const textColor = n <= 5 ? r.pill.text : '#fff';
              return `<button class="score-btn ${sel ? 'selected' : ''}"
                style="background:${bg}; color:${textColor};"
                onclick="setScore('${dish.replace(/'/g,"\\'")}','${r.name}',${n})">${n}</button>`;
            }).join('')}
          </div>
        </div>
      `).join('')}
      <div class="dish-total">
        <span class="dish-total-label">Dish score</span>
        <span class="dish-total-val">${totalStr}</span>
      </div>
    `;
    container.appendChild(card);
  });

  updateOverall();
}

function setScore(dish, rater, score) {
  scores[dish][rater] = score;
  render();
}

function updateOverall() {
  const all = dishes.flatMap(d => Object.values(scores[d]).filter(v => v !== null));
  const total = all.reduce((s, v) => s + v, 0);
  document.getElementById('overall-num').textContent = all.length > 0 ? total : '—';
  document.getElementById('overall-denom').textContent = all.length > 0 ? ` / ${all.length * 10}` : '';
}

function handleSubmit() {
  const incomplete = dishes.some(d => Object.values(scores[d]).some(v => v === null));
  if (incomplete) {
    alert('Please rate all dishes for Alex, Noreen, and Elia before submitting.');
    return;
  }
  document.getElementById('success-banner').style.display = 'block';
  document.querySelector('.submit-btn').style.display = 'none';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

loadDishes();
</script>
</body>
</html>
